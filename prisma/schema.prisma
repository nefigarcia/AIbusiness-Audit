generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  VIEWER
}

enum LeadStatus {
  NEW
  CALL_SCHEDULED
  CALL_IN_PROGRESS
  CALL_COMPLETED
  REPORT_GENERATED
  REPORT_SENT
  CONSULTATION_SCHEDULED
  CONVERTED
  LOST
}

enum Industry {
  HEALTHCARE
  LEGAL
  REAL_ESTATE
  CONTRACTOR
  LOCAL_SERVICE
  OTHER
}

enum CompanySize {
  SOLO
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

enum SessionStatus {
  PENDING
  CALL_INITIATED
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  role      UserRole @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@map("users")
}

model Lead {
  id                 String       @id @default(cuid())
  name               String
  email              String
  phone              String
  businessName       String
  industry           Industry
  companySize        CompanySize
  mainChallenge      String       @db.Text
  status             LeadStatus   @default(NEW)
  qualificationScore Int?
  notes              String?      @db.Text
  source             String?      @default("website")
  ipAddress          String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  auditSessions AuditSession[]
  followUpTasks FollowUpTask[]
  activityLogs  ActivityLog[]

  @@index([email])
  @@index([status])
  @@index([industry])
  @@index([createdAt])
  @@map("leads")
}

model AuditSession {
  id           String        @id @default(cuid())
  leadId       String
  vapiCallId   String?       @unique
  status       SessionStatus @default(PENDING)
  scheduledAt  DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  duration     Int?
  errorMessage String?       @db.Text
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  lead       Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  transcript CallTranscript?
  report     AIReport?

  @@index([leadId])
  @@index([status])
  @@index([vapiCallId])
  @@map("audit_sessions")
}

model CallTranscript {
  id            String       @id @default(cuid())
  sessionId     String       @unique
  rawTranscript String       @db.LongText
  summary       String?      @db.Text
  extractedData Json?
  callDuration  Int?
  recordingUrl  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  session AuditSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("call_transcripts")
}

model AIReport {
  id                    String       @id @default(cuid())
  sessionId             String       @unique
  executiveSummary      String       @db.Text
  bottlenecks           Json
  opportunities         Json
  estimatedROI          Json
  implementationRoadmap Json
  recommendedSystems    Json
  htmlContent           String       @db.LongText
  qualificationScore    Int
  sentAt                DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  session AuditSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([qualificationScore])
  @@map("ai_reports")
}

model FollowUpTask {
  id          String    @id @default(cuid())
  leadId      String
  title       String
  description String?   @db.Text
  dueDate     DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  priority    Priority  @default(MEDIUM)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([dueDate])
  @@index([completed])
  @@map("follow_up_tasks")
}

model ActivityLog {
  id        String   @id @default(cuid())
  leadId    String
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([createdAt])
  @@map("activity_logs")
}
