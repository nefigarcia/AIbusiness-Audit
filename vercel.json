{
  "functions": {
    "app/api/reports/generate/route.ts": {
      "maxDuration": 60
    },
    "app/api/webhooks/vapi/route.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/webhooks/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
